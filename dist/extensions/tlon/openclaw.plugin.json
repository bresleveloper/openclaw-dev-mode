{
  "id": "tlon",
  "categories": [
    "channels"
  ],
  "doctorContract": {
    "configRepair": true
  },
  "name": "Tlon/Urbit",
  "description": "OpenClaw Tlon/Urbit channel plugin for chat workflows.",
  "activation": {
    "onStartup": false
  },
  "channels": [
    "tlon"
  ],
  "skills": [
    "./bundled-skills/@tloncorp/tlon-skill"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "tlon": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "configWrites": {
            "type": "boolean"
          },
          "mediaMaxMb": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ship": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "network": {
            "type": "object",
            "properties": {
              "dangerouslyAllowPrivateNetwork": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "groupChannels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dmAllowlist": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "clubPolicy": {
            "type": "string",
            "enum": [
              "approve-once",
              "approve-each",
              "disabled"
            ]
          },
          "clubRules": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^0v(?:0|[1-9a-v][0-9a-v]{0,4}(?:\\.[0-9a-v]{5})*)$"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "allow",
                "deny"
              ]
            }
          },
          "groupInviteAllowlist": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "autoDiscoverChannels": {
            "type": "boolean"
          },
          "crossChannelCitations": {
            "type": "boolean"
          },
          "showModelSignature": {
            "type": "boolean"
          },
          "responsePrefix": {
            "type": "string"
          },
          "requireMentionInBotThreads": {
            "type": "boolean"
          },
          "implicitMentions": {
            "type": "object",
            "properties": {
              "replyToBot": {
                "type": "boolean"
              },
              "quotedBot": {
                "type": "boolean"
              },
              "threadParticipation": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "autoAcceptDmInvites": {
            "type": "boolean"
          },
          "autoAcceptGroupInvites": {
            "type": "boolean"
          },
          "ownerShip": {
            "type": "string",
            "minLength": 1
          },
          "historyLimit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "authorization": {
            "type": "object",
            "properties": {
              "channelRules": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "restricted",
                        "open"
                      ]
                    },
                    "allowedShips": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "requireMentionInBotThreads": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "defaultAuthorizedShips": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "accounts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "configWrites": {
                  "type": "boolean"
                },
                "mediaMaxMb": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "ship": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "network": {
                  "type": "object",
                  "properties": {
                    "dangerouslyAllowPrivateNetwork": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "groupChannels": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "dmAllowlist": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "clubPolicy": {
                  "type": "string",
                  "enum": [
                    "approve-once",
                    "approve-each",
                    "disabled"
                  ]
                },
                "clubRules": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^0v(?:0|[1-9a-v][0-9a-v]{0,4}(?:\\.[0-9a-v]{5})*)$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "enum": [
                      "allow",
                      "deny"
                    ]
                  }
                },
                "groupInviteAllowlist": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "autoDiscoverChannels": {
                  "type": "boolean"
                },
                "crossChannelCitations": {
                  "type": "boolean"
                },
                "showModelSignature": {
                  "type": "boolean"
                },
                "responsePrefix": {
                  "type": "string"
                },
                "requireMentionInBotThreads": {
                  "type": "boolean"
                },
                "implicitMentions": {
                  "type": "object",
                  "properties": {
                    "replyToBot": {
                      "type": "boolean"
                    },
                    "quotedBot": {
                      "type": "boolean"
                    },
                    "threadParticipation": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "autoAcceptDmInvites": {
                  "type": "boolean"
                },
                "autoAcceptGroupInvites": {
                  "type": "boolean"
                },
                "ownerShip": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "label": "Tlon",
      "description": "decentralized messaging on Urbit; install the plugin to enable.",
      "uiHints": {
        "implicitMentions": {
          "label": "Tlon Implicit Mentions",
          "help": "Control which Tlon reply, quote, and thread-participation signals count as mentions. Unset flags preserve the channel defaults."
        },
        "implicitMentions.replyToBot": {
          "label": "Tlon Replies to Bot",
          "help": "Treat replies to the bot's own messages as implicit mentions when the channel reports that signal."
        },
        "implicitMentions.quotedBot": {
          "label": "Tlon Quoted Bot Messages",
          "help": "Treat messages quoting the bot as implicit mentions when the channel reports that signal."
        },
        "implicitMentions.threadParticipation": {
          "label": "Tlon Thread Participation",
          "help": "Treat follow-ups in threads where the bot participated as implicit mentions when the channel reports that signal."
        },
        "requireMentionInBotThreads": {
          "label": "Require Mention in Bot Threads",
          "help": "Override mention gating when this account's ship authored the thread root. False allows unmentioned replies; true requires a mention even after the bot participates. Omit to preserve existing behavior. Sender authorization still applies."
        },
        "accounts.*.requireMentionInBotThreads": {
          "label": "Require Mention in Bot Threads",
          "help": "Override mention gating when this account's ship authored the thread root. False allows unmentioned replies; true requires a mention even after the bot participates. Omit to preserve existing behavior. Sender authorization still applies."
        },
        "authorization.channelRules.*.requireMentionInBotThreads": {
          "label": "Require Mention in Bot Threads",
          "help": "Override mention gating when this account's ship authored the thread root. False allows unmentioned replies; true requires a mention even after the bot participates. Omit to preserve existing behavior. Sender authorization still applies."
        },
        "clubPolicy": {
          "label": "Tlon Group DM Policy",
          "help": "Default: approve-once. Enable each club once for automatic replies, require approval for every message with approve-each, or disable group DMs. Club authors and participants are unverified."
        },
        "accounts.*.clubPolicy": {
          "label": "Tlon Group DM Policy",
          "help": "Default: approve-once. Enable each club once for automatic replies, require approval for every message with approve-each, or disable group DMs. Club authors and participants are unverified."
        },
        "clubRules": {
          "label": "Tlon Group DM Rules",
          "help": "Club IDs mapped to allow or deny. Allow accepts unverified input delivered under that club ID with the agent's normal permitted tools; it does not authenticate participants or grant owner authority. Deny blocks the club, not a claimed ship. Approve-each still requires each message; disabled overrides all rules."
        },
        "accounts.*.clubRules": {
          "label": "Tlon Group DM Rules",
          "help": "Club IDs mapped to allow or deny. Allow accepts unverified input delivered under that club ID with the agent's normal permitted tools; it does not authenticate participants or grant owner authority. Deny blocks the club, not a claimed ship. Approve-each still requires each message; disabled overrides all rules."
        },
        "crossChannelCitations": {
          "label": "Tlon Cross-Channel Citations",
          "help": "Expand citations of posts from other channels into agent context. False expands only citations of the channel a message was posted in; the owner's 1:1 DMs are exempt. Default: true."
        },
        "accounts.*.crossChannelCitations": {
          "label": "Tlon Cross-Channel Citations",
          "help": "Expand citations of posts from other channels into agent context. False expands only citations of the channel a message was posted in; the owner's 1:1 DMs are exempt. Default: true."
        }
      }
    }
  }
}
